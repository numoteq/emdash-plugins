{
	"name": "@numoteq/emdash-plugin-sgtm",
	"version": "0.0.0",
	"description": "First-party, ad-blocker-resistant proxy from an Astro site on Cloudflare Workers to self-hosted server-side Google Tag Manager",
	"keywords": [
		"astro",
		"cloudflare-workers",
		"emdash",
		"google-tag-manager",
		"server-side-tagging",
		"sgtm"
	],
	"homepage": "https://github.com/numoteq/emdash-plugins/tree/main/packages/sgtm#readme",
	"bugs": {
		"url": "https://github.com/numoteq/emdash-plugins/issues"
	},
	"license": "MIT",
	"author": {
		"name": "NUMOTEQ s.r.o.",
		"email": "info@numoteq.com",
		"url": "https://www.numoteq.com"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/numoteq/emdash-plugins.git",
		"directory": "packages/sgtm"
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"type": "module",
	"sideEffects": false,
	"main": "dist/index.mjs",
	"exports": {
		".": {
			"import": "./dist/index.mjs",
			"types": "./dist/index.d.mts"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsdown",
		"test": "vitest run",
		"typecheck": "tsc --noEmit"
	},
	"devDependencies": {
		"tsdown": "0.23.0",
		"typescript": "6.0.3",
		"vitest": "5.0.3"
	},
	"peerDependencies": {
		"astro": ">=5"
	}
}
