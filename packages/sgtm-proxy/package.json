{
	"name": "@numoteq/sgtm-proxy",
	"version": "1.0.1",
	"description": "First-party, ad-blocker-resistant proxy from a Cloudflare Worker to self-hosted server-side Google Tag Manager",
	"keywords": [
		"astro",
		"cloudflare-workers",
		"google-tag-manager",
		"server-side-tagging",
		"sgtm"
	],
	"homepage": "https://github.com/numoteq/js-packages/tree/main/packages/sgtm-proxy#readme",
	"bugs": {
		"url": "https://github.com/numoteq/js-packages/issues"
	},
	"license": "MIT",
	"author": {
		"name": "NUMOTEQ s.r.o.",
		"email": "info@numoteq.com",
		"url": "https://www.numoteq.com"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/numoteq/js-packages.git",
		"directory": "packages/sgtm-proxy"
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"type": "module",
	"sideEffects": false,
	"main": "dist/index.mjs",
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"import": "./dist/index.mjs"
		},
		"./client": {
			"types": "./dist/client.d.mts",
			"import": "./dist/client.mjs"
		},
		"./astro": {
			"types": "./dist/astro.d.mts",
			"import": "./dist/astro.mjs"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsdown",
		"test": "vitest run",
		"typecheck": "tsc --noEmit"
	},
	"devDependencies": {
		"@effect/vitest": "4.0.5",
		"astro": "7.4.0",
		"effect": "4.0.5",
		"tsdown": "0.23.1",
		"typescript": "6.0.3",
		"vitest": "5.0.5"
	},
	"peerDependencies": {
		"astro": ">=5",
		"effect": "^4.0.0"
	},
	"peerDependenciesMeta": {
		"astro": {
			"optional": true
		}
	}
}
