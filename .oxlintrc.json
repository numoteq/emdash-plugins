{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"categories": {
		"correctness": "error",
		"suspicious": "warn",
		"perf": "warn"
	},
	"rules": {
		"vitest/no-standalone-expect": ["error", { "additionalTestBlockFunctions": ["it.effect"] }]
	},
	"ignorePatterns": ["**/dist/**", "**/node_modules/**"]
}
